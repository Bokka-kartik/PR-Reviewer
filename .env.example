# Copy to .env and fill in. Never commit .env.
# Step-by-step instructions for every value: docs/SETUP.md

# --- GitHub App (created at github.com/settings/apps) ---
GITHUB_APP_ID=123456
# Contents of the downloaded .pem file, on ONE line, with the line breaks written as \n
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# Any long random string; must match the "Webhook secret" you set on the GitHub App
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Dashboard ---
# At least 16 characters. You type this into the dashboard's sign-in screen.
DASHBOARD_TOKEN=change-me-to-a-long-random-token

# --- Optional tuning ---
# MONGO_URI=mongodb://localhost:27017/pr-reviewer   (docker compose sets this for you)
# PORT=3001
# MAX_DIFF_CHARS=300000
# REVIEW_CONCURRENCY=2
